# Frase para cifrar las contraseñas de las cámaras. Si se cambia, hay que recargar las credenciales.
SECRET_KEY=cambiar-esta-frase
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888
CAMERA_TIMEOUT_S=8
